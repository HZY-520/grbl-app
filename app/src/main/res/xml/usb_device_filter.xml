<?xml version="1.0" encoding="utf-8"?>
<!--
  USB 设备过滤：用于响应 android.hardware.usb.action.USB_DEVICE_ATTACHED。

  官方推荐写法：可以按 vendor-id / product-id / class 精确列出支持的设备，
  也可以用一个不带任何属性的 <usb-device /> 匹配所有 USB 设备。此处两者并用，
  前面的具体条目用于文档化常见 USB 转串口芯片，最后的空条目作为兜底匹配所有设备。

  内容与 v2 android/app/src/main/res/xml/usb_device_filter.xml 逐条一致（Phase 3 原样保留）。
-->
<resources>

    <!-- FTDI（FT232/FT2232 等） -->
    <usb-device vendor-id="0x0403" />

    <!-- WCH CH340 / CH341 / CH9102 -->
    <usb-device vendor-id="0x1a86" />

    <!-- Silicon Labs CP210x -->
    <usb-device vendor-id="0x10c4" />

    <!-- Prolific PL2303 -->
    <usb-device vendor-id="0x067b" />

    <!-- Arduino（含官方开发板） -->
    <usb-device vendor-id="0x2341" />

    <!-- CDC / ACM 通用类（class=2, subclass=2, protocol=1） -->
    <usb-device class="2" subclass="2" protocol="1" />

    <!-- 兜底：不带任何属性时匹配所有 USB 设备 -->
    <usb-device />

</resources>
